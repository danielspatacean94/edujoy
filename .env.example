PORT=3000
MONGODB_URI=mongodb://localhost:27017/edujoy
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Optional: number of days before a user's password is forced to expire.
# Leave unset to disable password expiry.
PASSWORD_EXPIRY_DAYS=90

# AES-256-GCM key used by CryptoService for encrypting sensitive fields (min 32 chars)
ENCRYPTION_KEY=change-me-32-characters-minimum

# Cloudflare R2 (S3-compatible) object storage, used by S3Service
CF_R2_BUCKET=
CF_R2_ENDPOINT=
CF_S3_ACCESS_KEY_ID=
CF_S3_TOKEN_SECRET=

NODE_ENV=local
